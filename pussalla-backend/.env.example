# Copy this file to .env and fill in real values before running the server.
# In production (e.g. Render), set these as environment variables in the dashboard
# instead — never commit a real .env to git.

# PostgreSQL connection — a single connection string (recommended, takes priority):
DATABASE_URL=postgres://pussalla_app:change_me@localhost:5432/pussalla

# Or individual fields (used only when DATABASE_URL is unset):
# PGHOST=localhost
# PGPORT=5432
# PGDATABASE=pussalla
# PGUSER=pussalla_app
# PGPASSWORD=change_me

# Auth
JWT_SECRET=replace_with_a_long_random_string
JWT_EXPIRES_IN=8h

# Server
PORT=4000
# When serving the frontend from the same origin (the default in production),
# leave CORS_ORIGIN empty. Set it only if the frontend is on a different host.
CORS_ORIGIN=

# Seed script: default password assigned to every seeded employee login
SEED_DEFAULT_PASSWORD=Pussalla@123
